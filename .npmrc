# This project has a legacy dependency graph: the @reach/* UI components (v0.11)
# peer-require React 16, while react-dom is pinned to ^17. npm's strict peer
# resolution (npm 7+, and `npm ci`) rejects this, though the app runs fine with
# the resolved tree. legacy-peer-deps restores the npm 6 behaviour so installs
# are reproducible locally and in CI.
# TODO (dependency modernization): align react/react-dom versions and upgrade
# @reach/* (or migrate off it), then remove this flag.
legacy-peer-deps=true
